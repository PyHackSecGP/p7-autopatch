# DefectDojo API
DOJO_URL=http://192.168.1.205:8080
DOJO_TOKEN=

# Comma-separated CT IDs to never auto-patch (hypervisor, data stores, etc.)
SKIP_HOSTS=

# Default target CT services whose systemctl is-active must stay green post-patch.
# Format: ctid:svc1,svc2;ctid:svc3,svc4
HEALTHCHECKS=209:ssh;205:docker,uwsgi;207:docker;206:docker
